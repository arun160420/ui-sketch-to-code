# OpenAI API Configuration
# Replace with your actual key in a local .env file (DO NOT commit .env to version control)
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection for Code Generation
OPENAI_MODEL=gpt-4o-mini

# API Request Options
OPENAI_MAX_TOKENS=2500
OPENAI_TEMPERATURE=0.2

# Local Ollama / LLaVA Configuration (Week 4 Fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava:7b

# Routing Strategy: AUTO (try GPT-4o-mini then fallback to LLaVA), GPT_ONLY, LLAVA_ONLY
MODEL_ROUTER_STRATEGY=AUTO
